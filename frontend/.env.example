# Only PUBLIC values belong here. Anything prefixed VITE_ is shipped to the browser.
# Never put database URLs, JWT secrets or payment secrets in this file.

# API base URL. In development leave as /api (Vite proxies it to the backend).
# In production set the full URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# WhatsApp number in international format without + (country code first)
VITE_WHATSAPP_NUMBER=

VITE_INSTAGRAM_URL=
VITE_BRAND_NAME=
