# Little Gifts Story - environment overview (variable names only, no values).
# Each app has its own env file: copy that app's .env.example to .env and fill it in.
# This root file is only a pointer; nothing reads it.
#
# backend/.env   (template: backend/.env.example) - server-side, may hold secrets
#   PORT
#   NODE_ENV
#   MONGODB_URI
#   JWT_SECRET
#   JWT_EXPIRES_IN
#   FRONTEND_URL
#   WHATSAPP_NUMBER
#   IMAGE_STORAGE_PROVIDER
#   IMAGE_STORAGE_API_KEY
#   IMAGE_STORAGE_API_SECRET
#   RAZORPAY_KEY_ID
#   RAZORPAY_KEY_SECRET
#   DELIVERY_CHARGE
#   FREE_DELIVERY_ABOVE
#   ADMIN_NAME
#   ADMIN_EMAIL
#   ADMIN_PASSWORD
#
# frontend/.env  (template: frontend/.env.example) - public values only, shipped to the browser
#   VITE_API_BASE_URL
#   VITE_WHATSAPP_NUMBER
#   VITE_INSTAGRAM_URL
#   VITE_BRAND_NAME
