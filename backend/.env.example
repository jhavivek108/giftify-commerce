# Little Gifts Story API - copy this file to .env and fill in the blanks.
# Never commit the real .env file.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (required) ---
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/<database>
# Local MongoDB:  mongodb://127.0.0.1:27017/little-gifts-story
MONGODB_URI=

# --- Auth (required) ---
# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Frontend ---
# Allowed browser origin(s) for CORS. Comma-separate several.
FRONTEND_URL=http://localhost:5173
# WhatsApp number with country code, digits only (no + sign).
WHATSAPP_NUMBER=

# --- Image storage ---
# "local" stores uploads in backend/uploads. Cloud providers are not implemented yet.
IMAGE_STORAGE_PROVIDER=local
IMAGE_STORAGE_API_KEY=
IMAGE_STORAGE_API_SECRET=

# --- Razorpay (optional; online payments stay disabled while these are empty) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Extras ---
# Flat delivery charge in rupees. Delivery becomes free once the subtotal
# reaches FREE_DELIVERY_ABOVE (0 = never free automatically).
DELIVERY_CHARGE=0
FREE_DELIVERY_ABOVE=0
# Admin account created by "npm run seed" (password: at least 8 characters).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional, only when hosted behind a reverse proxy (Render, Railway, nginx...).
# Uncomment and set to the number of proxies in front of the app, usually 1.
# TRUST_PROXY=1
